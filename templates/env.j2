USE_PAYMENTS={{ 'True' if healthchecks_environment_variable_use_payments else 'False' }}

VICTOROPS_ENABLED={{ 'True' if healthchecks_environment_variable_victorops_enabled else 'False' }}

WEBHOOKS_ENABLED={{ 'True' if healthchecks_environment_variable_webhooks_enabled else 'False' }}

ZULIP_ENABLED={{ 'True' if healthchecks_environment_variable_zulip_enabled else 'False' }}

{{ healthchecks_environment_variables_additional_variables }}
