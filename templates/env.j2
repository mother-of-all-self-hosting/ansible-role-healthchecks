TZ={{ healthchecks_environment_variables_tz }}

ADMINS={{ healthchecks_environment_variable_admins | default([]) | join(',') }}

ALLOWED_HOSTS={{ healthchecks_environment_variable_allowed_hosts }}

APPRISE_ENABLED={{ 'True' if healthchecks_environment_variable_apprise_enabled else 'False' }}

DB={{ healthchecks_database_type }}

{% if healthchecks_database_type == 'mysql' %}
DB_CONN_MAX_AGE={{ healthchecks_environment_variable_db_conn_max_age }}
DB_HOST={{ healthchecks_database_environment_variables_database_host_mysql }}
DB_PORT={{ healthchecks_database_mysql_port }}
DB_USER={{ healthchecks_database_mysql_username }}
DB_PASSWORD={{ healthchecks_database_mysql_password }}
DB_NAME={{ healthchecks_database_name }}
{% endif %}

{% if healthchecks_database_type == 'postgres' %}
DB_CONN_MAX_AGE={{ healthchecks_environment_variable_db_conn_max_age }}
DB_HOST={{ healthchecks_database_environment_variables_database_host_postgres }}
DB_PORT={{ healthchecks_database_postgres_port }}
DB_USER={{ healthchecks_database_postgres_username }}
DB_PASSWORD={{ healthchecks_database_postgres_password }}
DB_SSLMODE={{ healthchecks_database_postgres_sslmode }}
DB_NAME={{ healthchecks_database_name }}
DB_TARGET_SESSION_ATTRS={{ healthchecks_environment_variable_db_target_session_attrs }}
{% endif %}

{% if healthchecks_database_type == 'sqlite' %}
DB_NAME={{ healthchecks_database_sqlite_name }}
{% endif %}

DEBUG={{ healthchecks_environment_variable_debug | to_json | capitalize }}


DISCORD_CLIENT_ID={{ healthchecks_environment_variable_discord_client_id }}
DISCORD_CLIENT_SECRET={{ healthchecks_environment_variable_discord_client_secret }}

DEFAULT_FROM_EMAIL={{ healthchecks_environment_variable_default_from_email }}

EMAIL_HOST={{ healthchecks_environment_variable_email_host }}
EMAIL_PORT={{ healthchecks_environment_variable_email_port }}
EMAIL_USE_TLS={{ 'True' if healthchecks_environment_variable_email_use_tls else 'False' }}
EMAIL_USE_VERIFICATION={{ 'True' if healthchecks_environment_variable_email_use_verification else 'False' }}
EMAIL_HOST_USER={{ healthchecks_environment_variable_email_host_user }}
EMAIL_HOST_PASSWORD={{ healthchecks_environment_variable_email_host_password }}

INTEGRATIONS_ALLOW_PRIVATE_IPS={{ 'True' if healthchecks_environment_variable_integrations_allow_private_ips else 'False' }}

MASTER_BADGE_LABEL={{ healthchecks_environment_variable_master_badge_label }}

MATRIX_ACCESS_TOKEN={{ healthchecks_environment_variable_matrix_access_token }}
MATRIX_HOMESERVER={{ healthchecks_environment_variable_matrix_homeserver }}
MATRIX_USER_ID={{ healthchecks_environment_variable_matrix_user_id }}

MATTERMOST_ENABLED={{ 'True' if healthchecks_environment_variable_mattermost_enabled else 'False' }}

MSTEAMS_ENABLED={{ 'True' if healthchecks_environment_variable_msteams_enabled else 'False' }}

OPSGENIE_ENABLED={{ 'True' if healthchecks_environment_variable_opsgenie_enabled else 'False' }}

PAGERTREE_ENABLED={{ 'True' if healthchecks_environment_variable_pagertree_enabled else 'False' }}

PD_APP_ID={{ healthchecks_environment_variable_pd_app_id }}
PD_ENABLED={{ 'True' if healthchecks_environment_variable_pd_enabled else 'False' }}

PING_BODY_LIMIT={{ healthchecks_environment_variable_ping_body_limit }}
PING_EMAIL_DOMAIN={{ healthchecks_environment_variable_ping_email_domain }}
PING_ENDPOINT={{ healthchecks_environment_variable_ping_endpoint }}

PROMETHEUS_ENABLED={{ 'True' if healthchecks_environment_variable_prometheus_enabled else 'False' }}

PUSHBULLET_CLIENT_ID={{ healthchecks_environment_variable_pushbullet_client_id }}
PUSHBULLET_CLIENT_SECRET={{ healthchecks_environment_variable_pushbullet_client_secret }}

PUSHOVER_API_TOKEN={{ healthchecks_environment_variable_pushover_api_token }}
PUSHOVER_EMERGENCY_EXPIRATION={{ healthchecks_environment_variable_pushover_emergency_expiration }}
PUSHOVER_EMERGENCY_RETRY_DELAY={{ healthchecks_environment_variable_pushover_emergency_retry_delay }}
PUSHOVER_SUBSCRIPTION_URL={{ healthchecks_environment_variable_pushover_subscription_url }}

REGISTRATION_OPEN={{ 'True' if healthchecks_environment_variable_registration_open else 'False' }}

REMOTE_USER_HEADER={{ healthchecks_environment_variable_remote_user_header }}
RP_ID={{ healthchecks_environment_variable_rp_id }}

S3_ACCESS_KEY={{ healthchecks_environment_variable_s3_access_key }}
S3_BUCKET={{ healthchecks_environment_variable_s3_bucket }}
S3_ENDPOINT={{ healthchecks_environment_variable_s3_endpoint }}
S3_REGION={{ healthchecks_environment_variable_s3_region }}
S3_SECRET_KEY={{ healthchecks_environment_variable_s3_secret_key }}
S3_TIMEOUT={{ healthchecks_environment_variable_s3_timeout }}

SECRET_KEY={{ healthchecks_environment_variable_secret_key }}

SHELL_ENABLED={{ 'True' if healthchecks_environment_variable_shell_enabled else 'False' }}

SIGNAL_CLI_SOCKET={{ healthchecks_environment_variable_signal_cli_socket }}

SITE_LOGO_URL={{ healthchecks_environment_variable_site_logo_url }}
SITE_NAME={{ healthchecks_environment_variable_site_name }}
SITE_ROOT={{ healthchecks_environment_variable_site_root }}

SLACK_CLIENT_ID={{ healthchecks_environment_variable_slack_client_id }}
SLACK_CLIENT_SECRET={{ healthchecks_environment_variable_slack_client_secret }}
SLACK_ENABLED={{ 'True' if healthchecks_environment_variable_slack_enabled else 'False' }}

SPIKE_ENABLED={{ 'True' if healthchecks_environment_variable_spike_enabled else 'False' }}

TELEGRAM_BOT_NAME={{ healthchecks_environment_variable_telegram_bot_name }}
TELEGRAM_TOKEN={{ healthchecks_environment_variable_telegram_token }}

TRELLO_APP_KEY={{ healthchecks_environment_variable_trello_app_key }}

TWILIO_ACCOUNT={{ healthchecks_environment_variable_twilio_account }}
TWILIO_AUTH={{ healthchecks_environment_variable_twilio_auth }}
TWILIO_FROM={{ healthchecks_environment_variable_twilio_from }}
